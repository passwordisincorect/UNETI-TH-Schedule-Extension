{
  "manifest_version": 3,
  "name": "UNETI - Lịch TH theo học phần",
  "version": "1.3.0",
  "description": "Tự đọc các môn Thực hành trên UNETI, nhập tiết/phòng/giảng viên và chèn lịch cá nhân trực tiếp vào lịch tuần với nền xanh nhạt.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sinhvien.uneti.edu.vn/*",
    "https://apisv.uneti.edu.vn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sinhvien.uneti.edu.vn/*",
        "https://apisv.uneti.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UNETI - Lịch học TH"
  }
}
